	column ช่วงเวลา
		lineageTag: 307fbd47-e4d1-4c8c-9877-194ce3cc7012
		summarizeBy: none
		isNameInferred
		sourceColumn: [ช่วงเวลา]

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source = ```
				
				VAR StartDate = DATE(2023, 1, 1)
				VAR EndDate = DATE(2026, 12, 31)
				VAR BaseCalendar = CALENDAR(StartDate, EndDate)
				VAR TodayDate = TODAY()
				VAR CurrentYear = YEAR(TodayDate)
				VAR CurrentMonth = MONTH(TodayDate)
				
				// ปีงบประมาณไทยปัจจุบัน (1 ต.ค. - 30 ก.ย.)
				VAR FYStart = IF(CurrentMonth >= 10, DATE(CurrentYear, 10, 1), DATE(CurrentYear - 1, 10, 1))
				VAR FYEnd = IF(CurrentMonth >= 10, DATE(CurrentYear + 1, 9, 30), DATE(CurrentYear, 9, 30))
				
				RETURN
				ADDCOLUMNS(
				    BaseCalendar,
				    "Year", YEAR([Date]),
				    "MonthNo", MONTH([Date]),
				    "MonthName", FORMAT([Date], "mmmm"),
				    "YearMonth", FORMAT([Date], "yyyy-mm"),
				    "ช่วงเวลา", 
				        SWITCH(
				            TRUE(),
				            YEAR([Date]) = CurrentYear && MONTH([Date]) = CurrentMonth, "เดือนปัจจุบัน",
				            YEAR([Date]) = YEAR(EDATE(TodayDate, -1)) && MONTH([Date]) = MONTH(EDATE(TodayDate, -1)), "เดือนก่อน",
				            [Date] >= FYStart && [Date] <= FYEnd && YEAR([Date]) <> CurrentYear, "ปีงบประมาณ",
				            YEAR([Date]) = CurrentYear, "ปีปัจจุบัน",
				            YEAR([Date]) = CurrentYear - 1, "ปีก่อน",
				            "ช่วงเวลาอื่น"
				        )
				)
				```

	annotation PBI_Id = c22fd204edc744a0bd8136260c499a4f

